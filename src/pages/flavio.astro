---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShareBlock from '../components/ShareBlock.astro';

const base = (import.meta.env.BASE_URL || '').replace(/\/$/, '');
---

<BaseLayout
  title="Pedido público de resposta | #AbraOSigilo"
  description="Página de pressão cidadã para solicitar uma posição pública sobre transparência, com direito de resposta e sem atribuição de irregularidade."
  page="flavio"
>
  <section class="hero" style="background: linear-gradient(135deg, #0b192c 0%, #1e3e62 45%, #000 100%);">
    <div class="container">
      <span class="destaque">PEDIDO PÚBLICO DE RESPOSTA</span>
      <h1>Flávio Bolsonaro:<br />qual é o seu compromisso?</h1>
      <p style="max-width: 780px; margin-top: 18px;">Esta página convida o senador a informar, de forma pública, se apoia um compromisso de transparência patrimonial verificável, com proteção de dados e fiscalização independente.</p>
      <p class="trust-note">A ausência de resposta não prova irregularidade. O objetivo é registrar uma pergunta e publicar a resposta com fonte e data.</p>
      <div class="hero-actions">
        <a id="flavio-whatsapp" href="#" target="_blank" rel="noopener" class="btn btn-amarelo btn-lg">ENVIAR PERGUNTA NO WHATSAPP</a>
        <a id="flavio-x" href="#" target="_blank" rel="noopener" class="btn btn-branco btn-lg">FAZER A PERGUNTA NO X</a>
        <a href={`${base}/compartilhe#criar-card`} class="btn btn-branco btn-lg">CRIAR CARD GRÁFICO</a>
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="container" style="max-width: 900px;">
      <h2 style="text-align: center;">A pergunta é objetiva</h2>
      <p style="text-align: center; color: var(--cinza-medio); max-width: 700px; margin: 10px auto 28px;">Pressão cidadã responsável pede posição pública, não espalha acusações.</p>
      <div class="grid-3">
        <article class="card-info"><div class="numero-card">1</div><h3>Apoia a proposta?</h3><p>O senador apoia regras de transparência patrimonial com limites, proteção de dados e fiscalização independente?</p></article>
        <article class="card-info"><div class="numero-card">2</div><h3>Qual compromisso assume?</h3><p>Há disposição para publicar um compromisso objetivo de integridade e responder a perguntas documentadas?</p></article>
        <article class="card-info"><div class="numero-card">3</div><h3>Onde está a resposta?</h3><p>Quando houver manifestação oficial, ela deve ser publicada com fonte, data e espaço para correção.</p></article>
      </div>
    </div>
  </section>

  <section class="secao-escura">
    <div class="container" style="max-width: 840px;">
      <h2 style="text-align: center;">Como esta página deve funcionar</h2>
      <div class="grid-2" style="margin-top: 24px;">
        <article class="card-info"><h3>Registro verificável</h3><p>Somente manifestações públicas ou respostas recebidas por canais oficiais devem ser registradas, sempre com link ou documento de origem.</p></article>
        <article class="card-info"><h3>Direito de correção</h3><p>O gabinete deve ter canal de contato para corrigir, complementar ou contestar a classificação publicada.</p></article>
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="container" style="max-width: 720px; text-align: center;">
      <h2>Mensagem pronta</h2>
      <p style="color: var(--cinza-medio);">O texto abaixo é uma pergunta cívica, não uma acusação.</p>
      <div id="flavio-message" style="background: #f0f4fa; border: 2px dashed var(--azul); border-radius: var(--radius-grande); padding: 20px; text-align: left; white-space: pre-line;"></div>
      <button id="flavio-copy" type="button" class="btn btn-azul" style="margin-top: 16px;">COPIAR MENSAGEM</button>
    </div>
  </section>

  <ShareBlock texto="Peço uma resposta pública sobre transparência patrimonial verificável, proteção de dados e fiscalização independente." urlDaPagina={`${base}/flavio`} mostrarCorrente={true} />
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const url = window.location.href;
    const message = `Senador Flávio Bolsonaro, solicito uma resposta pública: o senhor apoia transparência patrimonial verificável, com proteção de dados, fiscalização independente e direito de defesa?\n\nConheça a proposta: ${url}\n\n#AbraOSigilo`;
    const output = document.getElementById('flavio-message');
    const whatsapp = document.getElementById('flavio-whatsapp') as HTMLAnchorElement | null;
    const x = document.getElementById('flavio-x') as HTMLAnchorElement | null;
    const copy = document.getElementById('flavio-copy');
    if (output) output.textContent = message;
    if (whatsapp) whatsapp.href = `https://wa.me/?text=${encodeURIComponent(message)}`;
    if (x) x.href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(message)}`;
    copy?.addEventListener('click', () => navigator.clipboard.writeText(message).then(() => { copy.textContent = 'MENSAGEM COPIADA'; }));
  });
</script>
