---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  page: 'home' | 'flavio' | 'esquerda' | 'direita' | 'centrao' | 'compartilhe' | 'placar' | 'proposta' | 'constitucionalidade' | 'minuta-pec' | 'caminhos-legais';
}

const { title, description, page } = Astro.props;
const currentYear = new Date().getFullYear();
const base = (import.meta.env.BASE_URL || '').replace(/\/$/, '');

const navItems = [
  { href: `${base}/`, label: 'Início', page: 'home' as const },
  { href: `${base}/compartilhe`, label: 'Compartilhe', page: 'compartilhe' as const },
  { href: `${base}/placar`, label: 'Placar', page: 'placar' as const },
];
const documentoAtivo = ['proposta', 'minuta-pec', 'caminhos-legais', 'constitucionalidade'].includes(page);
const perspectivaAtiva = ['direita', 'esquerda', 'centrao', 'flavio'].includes(page);
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | #AbraOSigilo</title>
  <meta name="description" content={description}>
  <meta name="robots" content="index,follow">
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`}>
  <meta property="og:locale" content="pt_BR">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="#AbraOSigilo">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={`${base}/images/abra-o-sigilo-card.png`}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={`${base}/images/abra-o-sigilo-card.png`}>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    body { opacity: 1; }
  </style>
</head>
<body>
  <header class="header-site">
    <div class="container header-inner">
      <a href={base ? `${base}/` : '/'} class="header-logo">
        <span class="icone">!</span>
        <span>#AbraOSigilo</span>
      </a>
    </div>
  </header>

  <nav class="landing-nav" aria-label="Navegação principal">
    <div class="container landing-nav-inner">
      {navItems.map(item => (
        <a href={item.href} class={page === item.page ? 'atual' : ''}>
          {item.label}
        </a>
      ))}
      <details class="nav-grupo" open={documentoAtivo}>
        <summary class={documentoAtivo ? 'atual' : ''}>Documentos</summary>
        <div class="nav-submenu">
          <a href={`${base}/proposta`} class={page === 'proposta' ? 'atual' : ''}>A proposta</a>
          <a href={`${base}/minuta-pec`} class={page === 'minuta-pec' ? 'atual' : ''}>Minuta PEC</a>
          <a href={`${base}/caminhos-legais`} class={page === 'caminhos-legais' ? 'atual' : ''}>Caminhos legais</a>
          <a href={`${base}/constitucionalidade`} class={page === 'constitucionalidade' ? 'atual' : ''}>Base legal</a>
        </div>
      </details>
      <details class="nav-grupo" open={perspectivaAtiva}>
        <summary class={perspectivaAtiva ? 'atual' : ''}>Perspectivas</summary>
        <div class="nav-submenu">
          <a href={`${base}/direita`} class={page === 'direita' ? 'atual' : ''}>Anticorrupção</a>
          <a href={`${base}/esquerda`} class={page === 'esquerda' ? 'atual' : ''}>Social</a>
          <a href={`${base}/centrao`} class={page === 'centrao' ? 'atual' : ''}>Indecisos</a>
        </div>
      </details>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="footer-site">
    <div class="container">
      <p><strong>#AbraOSigilo</strong> — Movimento Cívico pela Transparência Patrimonial na Política</p>
      <p style="margin-top: 8px;">Isto não é sobre partido. É sobre regras claras, compromisso público e prestação de contas.</p>
      <p style="margin-top: 12px; font-size: 0.75rem;">© {currentYear} · Minutas e análises são materiais de debate público, não parecer jurídico.</p>
    </div>
  </footer>

</body>
</html>
